<div class="search-container">
    
    <h2>Search for Available Lab Slots</h2>
    <p>Find free computer stations by date, time, and location.</p>

    <div class="search-box">
        <form id="search-form">
            <div class="form-group">
                <label for="search-date">Date:</label>
                <input type="date" id="search-date" name="date" placeholder="e.g. Oct 25, 2023">
            </div>

            <div class="form-group">
                <label for="search-time">Time (Optional):</label>
                <input type="time" id="search-time" name="time" placeholder="e.g. 9:00 AM">
            </div>

            <div class="form-group">
                <label for="search-lab">Lab:</label>
                <select id="search-lab" name="lab">
                    <option value="all">All Labs</option>
                    <option value="lab-a">Computer Lab A (Science)</option>
                    <option value="lab-b">Computer Lab B (Library)</option>
                    <option value="mac-lab-a">Mac Lab A (Design)</option>
                    <option value="lab-c"> Computer Lab C (Engineering) </option>
                    <option value="mac-lab-b"> Mac Lab B (Arts) </option>
                </select>
            </div>

            <br>
            
            <button type="button" class="search-btn" onclick="filterSlots()">
                Search Availability
            </button>
        </form>
    </div>

    <h3>Available Results</h3>
    
    <table class="results-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time Slot</th>
                <th>Lab Name</th>
                <th>Station ID</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="results-body">
        </tbody>
    </table>

    <br><br>
    <a href="/home">Back to Home</a>

</div>