<div class="login-container">
    <h1>Welcome to AnimoSync!</h1>
    <p>Please enter your details below.</p>
    <br>

    {{#if error}}
        <div class="warning-login">
            <strong>Warning:</strong> {{error}}
        </div>
    {{/if}}
    
    <form action="/login" method="POST">
        <label for="username">User Email:</label><br>
        <input type="text" id="username" name="username" class="form-input" value="{{formData.username}}" required>
        <br><br>

        <label for="password">Password:</label><br>
        <input type="password" id="password" name="password" class="form-input" required>

        <div class="show-password">
            <input type="checkbox" id="toggle-login-password" style="cursor: pointer;">
            <label for="toggle-login-password" style="cursor: pointer; margin: 0; font-weight: normal;">Show Password</label>
        </div>
        
        <br><br><br>

        <button type="submit" class="submit-btn">Log In</button>

        <div class="signup-link">
            <p>Don't have an account? <a href="/sign_up">Sign Up</a></p>
            <p>Learn more about AnimoSync? <a href="/about_page">About Us</a></p>
        </div>

    </form>
    <br><br>
</div>