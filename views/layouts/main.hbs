<!DOCTYPE html>
<html>
<head>
    <title>AnimoSync</title>
    <link rel="icon" type="image/png" href="/animosync_logo.png">
    <link rel="stylesheet" href="/styles.css"> 
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div id="header">
        <span id="logo">
            <img src="/animosync_logo.png" alt="AnimoSync Logo" style="height: 40px; vertical-align: middle;">
            AnimoSync
        </span>
        
        {{#unless hideNav}}
        <div id="nav-links">
            
            <div class="dropdown">
                <button class="dropbtn">Profile ▼</button>
                <div class="dropdown-content">
                    {{#if isAdmin}}
                        <a href="/admin_profile">Admin Profile</a>
                        <a href="/admin_view">Admin Dashboard</a>
                    {{else}}
                        <a href="/profile">View Profile</a>
                        <a href="/my-reservations">My Reservations</a>
                    {{/if}}
                </div>
            </div>

            <a href="/about_page" id="about">About Page</a>
            <a href="/" id="logout-link">Log Out</a>
        </div>
        {{/unless}}
    </div>

    {{{body}}}

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/functions.js"></script>
    
</body>
</html>