<div class="container">
    <h2>Admin Management Dashboard</h2>
    <p>Welcome, {{user.name}}! Manage all current student reservations below.</p>

    <div class="search-box" style="margin-top: 20px;">
        <h3>All Active System Reservations</h3>
        <table class="schedule-table" style="width: 100%; margin-top: 15px;">
            <thead>
                <tr>
                    <th>Student Username</th>
                    <th>Date</th>
                    <th>Time Slot</th>
                    <th>Lab Location</th>
                    <th>Station</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="admin-reservations-body">
                </tbody>
        </table>
    </div>
</div>