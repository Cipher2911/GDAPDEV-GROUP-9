<div class="header">
    <a href="/admin_view" class="login-link">Back to Dashboard</a>
</div>

<div class="container">
    
    <div class="profile-card">
        <div class="profile-avatar">{{user.avatar}}</div>
        
        <h2>{{user.name}}</h2>
        
        <p class="profile-detail"><strong>Admin ID:</strong> <span>{{user.admin_id}}</span></p>
        <p class="profile-detail"><strong>Username:</strong> <span>{{user.username}}</span></p>
        <p class="profile-detail"><strong>Email:</strong> <span>{{user.email}}</span></p>
        
        <p id="status" class="active">System Administrator</p>
        
    </div>

    <hr class="divider">

</div>